{
  "name": "url-to-tutorial",
  "version": "0.1.0",
  "private": true,
  "description": "URL to editable walkthrough to Driver.js tutorial video",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "tutorial": "node src/cli.mjs",
    "demo": "node src/cli.mjs demo",
    "test:e2e": "node test/e2e.mjs",
    "studio": "node src/studio-server.mjs",
    "test:studio:e2e": "node test/studio.e2e.mjs",
    "test:hostinger:e2e": "node test/hostinger.e2e.mjs",
    "test:goal:e2e": "node test/goal.e2e.mjs",
    "test:narration:e2e": "node test/narration.e2e.mjs",
    "test:privacy:e2e": "node test/privacy.e2e.mjs",
    "benchmark": "node src/benchmark.mjs",
    "test:iframe-session:e2e": "node test/iframe-session.e2e.mjs",
    "test:discovery-public:e2e": "node test/discovery-public.e2e.mjs",
    "test:webreel:e2e": "node test/webreel-benchmark.e2e.mjs",
    "test:cloud:docker": "node test/cloud-egress-docker.mjs",
    "generate": "node scripts/codegen.mjs",
    "generate:check": "node scripts/codegen.mjs --check",
    "generate:adapter": "plop adapter",
    "typecheck": "tsc --project tsconfig.json",
    "build": "npm run generate && npm run typecheck && node scripts/build.mjs",
    "test:toolchain": "node --test test/toolchain.test.mjs",
    "test:build": "node --test test/build.smoke.mjs",
    "verify:toolchain": "npm run generate:check && npm run build && npm run test:toolchain && npm run test:build",
    "codegen:browser": "playwright codegen"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "driver.js": "1.10.2",
    "playwright": "1.64.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "plop": "4.0.5",
    "typescript": "7.0.2"
  }
}
